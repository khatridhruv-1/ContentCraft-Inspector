# Optional public site URL for SEO canonical links and Open Graph (production)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Groq — content generation, analysis, and outline (https://console.groq.com)
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Supabase app (required at runtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI (required for `npm run db:push` / `npm run db:link`)
# Create token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project ref from dashboard URL: https://supabase.com/dashboard/project/<project-ref>
SUPABASE_PROJECT_REF=

# Tavily — web search (Info Gain tab only)
# Free tier: https://tavily.com
# TAVILY_API_KEY=
