# Public site URL for SEO canonical links, Open Graph, and integration install commands
NEXT_PUBLIC_SITE_URL=https://blogcreator.dev

# Ollama Cloud — AI content generation (https://ollama.com/settings/keys)
OLLAMA_API_KEY=
# Optional: cloud model (default: qwen3.5:397b-cloud — best for long-form content)
# OLLAMA_MODEL=qwen3.5:397b-cloud
# Alternatives: kimi-k2.5:cloud (conversational), gpt-oss:120b-cloud (reasoning)
# Optional: API host (default: https://ollama.com)
# OLLAMA_API_HOST=https://ollama.com

# Groq — analysis, outline, and keyword AI assist (https://console.groq.com)
GROQ_API_KEY=

# Scraping Hub — keyword discovery and live search (https://fire.yamlcreator.dev/api/docs)
# Powers trending keywords (/trending/topic, /trending/words) and web search for list articles.
SCRAPING_HUB_API_KEY=
# Optional: override API base URL (default: https://fire.yamlcreator.dev/api)
# SCRAPING_HUB_API_URL=

# Supabase app (required at runtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI (required for `npm run db:push` / `npm run db:link`)
# Create token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project ref from dashboard URL: https://supabase.com/dashboard/project/<project-ref>
SUPABASE_PROJECT_REF=

# Tavily — web search for Info Gain tab (https://tavily.com)
# TAVILY_API_KEY=
