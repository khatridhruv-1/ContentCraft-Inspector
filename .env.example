# Google AI Studio
google_ai_studio_api_key=

# OpenAI (required by server API routes)
OPENAI_API_KEY=

# Appwrite (legacy support / compatibility)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
API_SECRET_KEY=

# Supabase app (required at runtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI (required for db push/link scripts)
# Create token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project ref from dashboard URL: https://supabase.com/dashboard/project/<project-ref>
SUPABASE_PROJECT_REF=
